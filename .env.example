# Copie para .env e preencha. Nenhum segredo tem valor padrão: sem eles o docker compose não sobe.
# Para gerar valores aleatórios:
#   bash/Git Bash:  openssl rand -hex 32
#   PowerShell:     -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })

MYSQL_ROOT_PASSWORD=

# Senha dos usuários de banco dos microsserviços (sem aspas simples nem barra invertida).
DB_PASSWORD=

# Chave HMAC do JWT, compartilhada por gateway e microsserviços: pelo menos 32 caracteres.
JWT_SECRET=

# Opcional: sem chave, o tutor funciona em "modo sem IA" (devolve trechos das aulas)
# e a geração de questões fica indisponível.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
